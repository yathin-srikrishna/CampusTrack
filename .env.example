FLASK_APP=run.py
FLASK_ENV=development
# Generate a unique random secret before running; do not use this placeholder.
SECRET_KEY=replace-with-a-long-random-secret
# Keep this database password in sync with sql/01_create_database.sql.
DATABASE_URL=mysql+pymysql://placement_user:Replace-With-Your-Strong-DB-Password-2026!@localhost:3306/placement_system?charset=utf8mb4
MAX_CONTENT_LENGTH=10485760
SESSION_COOKIE_SECURE=false
